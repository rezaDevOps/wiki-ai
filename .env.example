# ── Supabase ──────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, never expose to client
# Used by ingestion scripts and admin API routes
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI APIs ───────────────────────────────────────────────
# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (embeddings: text-embedding-3-small) — https://platform.openai.com/
OPENAI_API_KEY=sk-...

# ── App Config ────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Wiki AI

# ── GitHub Actions (set in repo secrets, not .env) ────────
# GITHUB_TOKEN is provided automatically by GitHub Actions
# VERCEL_TOKEN — for programmatic Vercel deploys
# VERCEL_ORG_ID — from vercel project settings
# VERCEL_PROJECT_ID — from vercel project settings
